{
  "name": "moja",
  "version": "1.0.0",
  "private": true,
  "description": "모자(MOJA) — 자립준비청년 지원정보 매칭 서비스. 판정 로직은 packages/core 에 한 곳만 둔다.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @moja/web",
    "build": "npm run build -w @moja/web",
    "start": "npm run start -w @moja/web",
    "typecheck": "npm run typecheck -w @moja/core && npm run typecheck -w @moja/web",
    "qa": "npm run qa -w @moja/core",
    "qa:engine": "npm run qa:engine -w @moja/core",
    "qa:adapter": "npm run qa:adapter -w @moja/core",
    "qa:catalog": "npm run qa:catalog -w @moja/core",
    "qa:boundary": "npm run qa:boundary -w @moja/core",
    "check": "npm run typecheck && npm run qa && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "nanoid": "^3.3.18",
    "sharp": "^0.35.0"
  },
  "engines": {
    "node": ">=22.5"
  }
}
