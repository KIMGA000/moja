    "qa:catalog": "tsx docs/qa/catalog-safety.test.ts",
    "qa:boundary": "tsx src/__tests__/boundary.test.ts",
    "qa": "npm run qa:engine && npm run qa:adapter && npm run qa:catalog && npm run qa:boundary"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4"
  }
}
